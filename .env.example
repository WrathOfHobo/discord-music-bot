# 複製這個檔案成 .env,填入你的 bot token
# (Discord Developer Portal → 你的 App → Bot → Reset Token)
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# 選填:Gemini(/find 找歌、/autoplay 自動電台、/lyrics 翻譯)
# 到 https://aistudio.google.com/apikey 取得免費金鑰
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 選填:Spotify 連結匯入(/spotify)
# 到 https://developer.spotify.com/dashboard 建立 App 取得
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# 選填:改用瀏覽器 cookie 取代 cookies.txt(firefox / chrome / edge)
# COOKIES_FROM_BROWSER=firefox

# 選填(強烈建議測試期填):你的伺服器 ID,填了指令會即時同步、馬上出現
# 取得方式:Discord 設定→進階→開啟「開發者模式」,右鍵伺服器圖示→複製伺服器 ID
DEV_GUILD_ID=

